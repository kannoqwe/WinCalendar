<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FFFF0088</Color>
            <Color x:Key="SystemAccentColorDark1">#FFD90074</Color>
            <Color x:Key="SystemAccentColorDark2">#FFBC0064</Color>
            <Color x:Key="SystemAccentColorDark3">#FF990050</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFF3DA5</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFF72BF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFA6D7</Color>

            <Color x:Key="AppPageBackgroundColor">#FFF7F3F7</Color>
            <Color x:Key="AppShellBackgroundColor">#FFFEFCFE</Color>
            <Color x:Key="AppSidebarBackgroundColor">#FFF8F5F8</Color>
            <Color x:Key="AppCardBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="AppCardAltBackgroundColor">#FFF6F1F6</Color>
            <Color x:Key="AppBorderColor">#FFE8DFE6</Color>
            <Color x:Key="AppLineColor">#FFF0E8EF</Color>
            <Color x:Key="AppTextMutedColor">#FF7B6F79</Color>
            <Color x:Key="AppAccentColor">#FFFF0088</Color>
            <Color x:Key="AppAccentMutedColor">#1CFF0088</Color>
            <Color x:Key="AppSuccessColor">#FF18A957</Color>
            <Color x:Key="CompactDividerColor">#0D000000</Color>
            <Color x:Key="CompactMutedColor">#8A000000</Color>
            <Color x:Key="CompactComposerPanelColor">#FFFFFFFF</Color>
            <Color x:Key="CompactPanelColor">#F2FFFFFF</Color>
            <Color x:Key="CompactTaskCardColor">#0D000000</Color>
            <Color x:Key="CompactTextColor">#FF1C1C1C</Color>

            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="{StaticResource AppPageBackgroundColor}" />
            <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="{StaticResource AppShellBackgroundColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource AppSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{StaticResource AppCardBackgroundColor}" />
            <SolidColorBrush x:Key="AppCardAltBackgroundBrush" Color="{StaticResource AppCardAltBackgroundColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppLineBrush" Color="{StaticResource AppLineColor}" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentMutedBrush" Color="{StaticResource AppAccentMutedColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="CompactDividerBrush" Color="{StaticResource CompactDividerColor}" />
            <SolidColorBrush x:Key="CompactMutedBrush" Color="{StaticResource CompactMutedColor}" />
            <SolidColorBrush x:Key="CompactComposerPanelBrush" Color="{StaticResource CompactComposerPanelColor}" />
            <SolidColorBrush x:Key="CompactPanelBrush" Color="{StaticResource CompactPanelColor}" />
            <SolidColorBrush x:Key="CompactTaskCardBrush" Color="{StaticResource CompactTaskCardColor}" />
            <SolidColorBrush x:Key="CompactTextBrush" Color="{StaticResource CompactTextColor}" />

            <LinearGradientBrush x:Key="AppHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#FFF7EFF4" Offset="0.6" />
                <GradientStop Color="#FFF3E4EE" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FFFF0088</Color>
            <Color x:Key="SystemAccentColorDark1">#FFD90074</Color>
            <Color x:Key="SystemAccentColorDark2">#FFBC0064</Color>
            <Color x:Key="SystemAccentColorDark3">#FF990050</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFF3DA5</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFF72BF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFA6D7</Color>

            <Color x:Key="AppPageBackgroundColor">#FF141217</Color>
            <Color x:Key="AppShellBackgroundColor">#FF19171D</Color>
            <Color x:Key="AppSidebarBackgroundColor">#FF1E1B22</Color>
            <Color x:Key="AppCardBackgroundColor">#FF232029</Color>
            <Color x:Key="AppCardAltBackgroundColor">#FF2B2630</Color>
            <Color x:Key="AppBorderColor">#FF322C36</Color>
            <Color x:Key="AppLineColor">#FF332F38</Color>
            <Color x:Key="AppTextMutedColor">#FFB7AFBA</Color>
            <Color x:Key="AppAccentColor">#FFFF0088</Color>
            <Color x:Key="AppAccentMutedColor">#1FFF0088</Color>
            <Color x:Key="AppSuccessColor">#FF42C87A</Color>
            <Color x:Key="CompactDividerColor">#24FFFFFF</Color>
            <Color x:Key="CompactMutedColor">#B8FFFFFF</Color>
            <Color x:Key="CompactComposerPanelColor">#FF211D25</Color>
            <Color x:Key="CompactPanelColor">#F21A171D</Color>
            <Color x:Key="CompactTaskCardColor">#20FFFFFF</Color>
            <Color x:Key="CompactTextColor">#FFF7F1F7</Color>

            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="{StaticResource AppPageBackgroundColor}" />
            <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="{StaticResource AppShellBackgroundColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource AppSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{StaticResource AppCardBackgroundColor}" />
            <SolidColorBrush x:Key="AppCardAltBackgroundBrush" Color="{StaticResource AppCardAltBackgroundColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppLineBrush" Color="{StaticResource AppLineColor}" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentMutedBrush" Color="{StaticResource AppAccentMutedColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="CompactDividerBrush" Color="{StaticResource CompactDividerColor}" />
            <SolidColorBrush x:Key="CompactMutedBrush" Color="{StaticResource CompactMutedColor}" />
            <SolidColorBrush x:Key="CompactComposerPanelBrush" Color="{StaticResource CompactComposerPanelColor}" />
            <SolidColorBrush x:Key="CompactPanelBrush" Color="{StaticResource CompactPanelColor}" />
            <SolidColorBrush x:Key="CompactTaskCardBrush" Color="{StaticResource CompactTaskCardColor}" />
            <SolidColorBrush x:Key="CompactTextBrush" Color="{StaticResource CompactTextColor}" />

            <LinearGradientBrush x:Key="AppHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF232027" Offset="0" />
                <GradientStop Color="#FF201C24" Offset="0.58" />
                <GradientStop Color="#FF261B24" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
