<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Calendar.UI.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MonthNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppCardAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>

        <Style x:Key="TaskIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="Root"
        Loaded="Root_Loaded"
        Padding="16">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="{Binding MonthLabel}" />
                    <TextBlock
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="{Binding SelectedDateText}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        Style="{StaticResource MonthNavButtonStyle}"
                        Click="PreviousMonthButton_Click"
                        ToolTipService.ToolTip="Previous month">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Style="{StaticResource MonthNavButtonStyle}"
                        Click="NextMonthButton_Click"
                        ToolTipService.ToolTip="Next month">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Viewbox
                    Stretch="Uniform"
                    StretchDirection="DownOnly"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <Border
                        Width="734"
                        Background="{ThemeResource AppCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="12">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Width="686"
                                HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="98" />
                                </Grid.ColumnDefinitions>

                                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="Mo" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="Tu" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="We" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="Th" />
                                <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="Fr" />
                                <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="Sa" />
                                <TextBlock Grid.Column="6" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextMutedBrush}" Text="Su" />
                            </Grid>

                            <ItemsControl
                                Grid.Row="1"
                                Width="686"
                                HorizontalAlignment="Center"
                                ItemsSource="{Binding MonthDays}"
                                IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="94"
                                            Height="72"
                                            Margin="2"
                                            Style="{StaticResource FlatButtonStyle}"
                                            Click="MonthDayButton_Click">
                                            <Grid Opacity="{Binding DayOpacity}">
                                                <Border
                                                    Visibility="{Binding SelectionVisibility}"
                                                    Background="{ThemeResource AppAccentMutedBrush}"
                                                    CornerRadius="14" />
                                                <Border
                                                    Visibility="{Binding TodayVisibility}"
                                                    BorderBrush="{ThemeResource AppAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14" />
                                                <StackPanel
                                                    Padding="10"
                                                    VerticalAlignment="Stretch"
                                                    Spacing="6">
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DayNumberText}" />
                                                    <StackPanel Spacing="3">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Text="{Binding StateText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Visibility="{Binding TaskIndicatorVisibility}"
                                                            Width="8"
                                                            Height="8"
                                                            Background="{Binding IndicatorBrush}"
                                                            CornerRadius="999" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Viewbox>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedDateText}" />
                            <TextBlock
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding SelectedDateSummary}" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="TASKS" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="Quick actions for the selected day." />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource IconActionButtonStyle}"
                                Click="AddTaskButton_Click"
                                ToolTipService.ToolTip="Add task">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Foreground="White"
                                    Glyph="&#xE710;" />
                            </Button>
                        </Grid>

                        <ListView
                            Grid.Row="2"
                            ItemsSource="{Binding SelectedDayTasks}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="12"
                                        Background="{Binding TaskBackgroundBrush}"
                                        BorderBrush="{Binding TaskBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Opacity="{Binding ContentOpacity}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                             <StackPanel
                                                 Spacing="2"
                                                 HorizontalAlignment="Left">
                                                 <TextBlock
                                                     FontWeight="SemiBold"
                                                     Text="{Binding Title}"
                                                     TextAlignment="Left"
                                                     TextTrimming="CharacterEllipsis" />
                                                 <TextBlock
                                                     Foreground="{Binding TaskAccentBrush}"
                                                     Text="{Binding CompactTimeText}"
                                                     TextAlignment="Left"
                                                     TextTrimming="CharacterEllipsis" />
                                             </StackPanel>
 
                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <Button
                                                    Style="{StaticResource TaskIconButtonStyle}"
                                                    Click="TaskOpenButton_Click"
                                                    ToolTipService.ToolTip="Open task">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Glyph="&#xE8A7;" />
                                                </Button>

                                                <Button
                                                    Margin="0,8,0,0"
                                                    Style="{StaticResource TaskIconButtonStyle}"
                                                    Click="TaskCompletionButton_Click"
                                                    ToolTipService.ToolTip="Toggle done state">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Glyph="&#xE73E;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
