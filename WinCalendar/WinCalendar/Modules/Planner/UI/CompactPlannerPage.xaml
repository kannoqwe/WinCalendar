<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="CompactDividerBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactMutedBrush" Color="#8A000000" />
        <SolidColorBrush x:Key="CompactPanelBrush" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="CompactTaskCardBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactTextBrush" Color="#FF1C1C1C" />

        <Style x:Key="CompactNewTaskButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="CompactMonthNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>

        <Style x:Key="CompactDayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CompactTaskItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="CompactTaskCompletionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="Root"
        Loaded="Root_Loaded">
        <Border
            Width="360"
            HorizontalAlignment="Stretch"
            Background="{StaticResource CompactPanelBrush}"
            BorderBrush="{StaticResource CompactDividerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="132" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource CompactTextBrush}"
                        Text="{Binding MonthLabel}" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            Click="PreviousMonthButton_Click"
                            Style="{StaticResource CompactMonthNavButtonStyle}"
                            ToolTipService.ToolTip="Previous month">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            Click="NextMonthButton_Click"
                            Style="{StaticResource CompactMonthNavButtonStyle}"
                            ToolTipService.ToolTip="Next month">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Width="322"
                    HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="Mo" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="Tu" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="We" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="Th" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="Fr" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="Sa" />
                    <TextBlock Grid.Column="6" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CompactMutedBrush}" Text="Su" />
                </Grid>

                <ItemsControl
                    Grid.Row="2"
                    Width="322"
                    HorizontalAlignment="Center"
                    IsTabStop="False"
                    ItemsSource="{Binding MonthDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="MonthDayButton_Click"
                                Style="{StaticResource CompactDayButtonStyle}">
                                <Grid Opacity="{Binding DayOpacity}">
                                    <Border
                                        Width="34"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AppAccentMutedBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding CompactSelectionVisibility}" />

                                    <Border
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AppAccentBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding TodayVisibility}" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding DayTextBrush}"
                                        Text="{Binding DayButtonText}" />

                                    <Border
                                        Width="12"
                                        Height="3"
                                        Margin="0,0,0,3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{Binding CompactIndicatorBrush}"
                                        CornerRadius="0"
                                        Visibility="{Binding TaskIndicatorVisibility}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Grid.Row="3"
                    Height="1"
                    Background="{StaticResource CompactDividerBrush}" />

                <Grid
                    Grid.Row="4"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Normal"
                        Foreground="{StaticResource CompactMutedBrush}"
                        Text="TODAY TASKS" />

                    <Button
                        Grid.Column="1"
                        Click="AddTaskButton_Click"
                        Content="+ NEW"
                        Style="{StaticResource CompactNewTaskButtonStyle}" />
                </Grid>

                <ListView
                    Grid.Row="5"
                    Height="132"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource CompactTaskItemContainerStyle}"
                    ItemsSource="{Binding SelectedDayTasks}"
                    SelectionMode="None"
                    Visibility="{Binding SelectedDayTasksVisibility}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="58"
                                Margin="0,0,0,8"
                                Padding="10,7"
                                Background="{StaticResource CompactTaskCardBrush}"
                                BorderBrush="{ThemeResource AppAccentBrush}"
                                BorderThickness="2,0,0,0"
                                CornerRadius="6"
                                Opacity="{Binding ContentOpacity}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource CompactTextBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="1"
                                            FontSize="11"
                                            Foreground="{StaticResource CompactMutedBrush}"
                                            Text="{Binding CompactTimeText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Button
                                        Grid.Column="1"
                                        Click="TaskCompletionButton_Click"
                                        Style="{StaticResource CompactTaskCompletionButtonStyle}"
                                        ToolTipService.ToolTip="Toggle done state">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="11"
                                            Glyph="&#xE73E;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource CompactMutedBrush}"
                    Text="{Binding EmptySelectedDayTasksText}"
                    Visibility="{Binding EmptySelectedDayTasksVisibility}" />
            </Grid>
        </Border>
    </Grid>
</Page>
