<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Loaded="Root_Loaded"
        Padding="16">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Background="{ThemeResource AppShellBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{Binding MonthLabel}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="{Binding WeekLabel}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="PreviousWeekButton_Click"
                        ToolTipService.ToolTip="Previous week">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76B;" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="CurrentWeekButton_Click"
                        Content="Today" />

                    <Button
                        Grid.Column="3"
                        Style="{StaticResource IconButtonStyle}"
                        Click="NextWeekButton_Click"
                        ToolTipService.ToolTip="Next week">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                    </Button>

                    <Button
                        Grid.Column="4"
                        Style="{StaticResource PrimaryToolbarButtonStyle}"
                        Click="AddTaskButton_Click"
                        Content="New task" />
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{ThemeResource AppShellBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="WEEK VIEW" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="{Binding WeekViewSummary}" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Padding="10,6"
                                Background="{ThemeResource AppPageBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="{Binding QuickAddTargetText}" />
                            </Border>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding WeekTimelineDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,8,0"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Click="WeekDayHeaderButton_Click">
                                        <Border
                                            Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                            Padding="10,8"
                                            Background="{ThemeResource AppPageBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <Grid>
                                                <Border
                                                    Visibility="{Binding SelectionVisibility}"
                                                    Background="{ThemeResource AppAccentMutedBrush}"
                                                    CornerRadius="12" />

                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="1">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Text="{Binding DayNameText}" />
                                                        <TextBlock
                                                            FontFamily="Segoe UI Variable Display"
                                                            FontSize="20"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding DayNumberText}" />
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="1"
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource AppAccentBrush}"
                                                        CornerRadius="999"
                                                        Visibility="{Binding TodayVisibility}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,8,0"
                            Spacing="0">
                            <Border
                                Height="{Binding WeekTimelineAnyTimeLaneHeight}"
                                Padding="0,8,0,0">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="ALL DAY" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding WeekTimelineHours}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}">
                                            <TextBlock
                                                VerticalAlignment="Top"
                                                FontSize="11"
                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                Text="{Binding LabelText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Grid.Column="1">
                            <ItemsControl
                                ItemsSource="{Binding WeekTimelineDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                            Margin="0,0,8,0"
                                            Background="{ThemeResource AppShellBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <Grid>
                                                <Border
                                                    Visibility="{Binding SelectionVisibility}"
                                                    Background="{ThemeResource AppAccentMutedBrush}"
                                                    Opacity="0.28"
                                                    CornerRadius="14" />

                                                <StackPanel Spacing="0">
                                                    <Grid Height="{Binding DataContext.WeekTimelineAnyTimeLaneHeight, ElementName=LayoutRoot}">
                                                        <Border
                                                            Background="Transparent"
                                                            Tapped="WeekAllDayLane_Tapped" />

                                                        <Border
                                                            Margin="0,0,0,1"
                                                            Background="{ThemeResource AppPageBackgroundBrush}" />

                                                        <StackPanel
                                                            Padding="8,6"
                                                            Spacing="4">
                                                            <TextBlock
                                                                Visibility="{Binding EmptyAllDayVisibility}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                                Text="Click to add" />

                                                            <ItemsControl ItemsSource="{Binding VisibleAllDayTasks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button
                                                                            Style="{StaticResource FlatButtonStyle}"
                                                                            Click="WeekAllDayTaskButton_Click">
                                                                            <Border
                                                                                Padding="6,4"
                                                                                Background="{Binding TaskBackgroundBrush}"
                                                                                BorderBrush="{Binding TaskBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Opacity="{Binding ContentOpacity}">
                                                                                <TextBlock
                                                                                    FontSize="11"
                                                                                    FontWeight="SemiBold"
                                                                                    Text="{Binding Title}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </Border>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Border
                                                                Visibility="{Binding HiddenAllDayTaskCountVisibility}"
                                                                Padding="6,3"
                                                                HorizontalAlignment="Left"
                                                                Background="{ThemeResource AppShellBackgroundBrush}"
                                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="999">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                                    Text="{Binding HiddenAllDayTaskCountText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}">
                                                        <Border
                                                            Background="Transparent"
                                                            Tapped="WeekTimedGrid_Tapped" />

                                                        <ItemsControl
                                                            IsHitTestVisible="False"
                                                            ItemsSource="{Binding DataContext.WeekTimelineHours, ElementName=LayoutRoot}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}"
                                                                        BorderBrush="{ThemeResource AppLineBrush}"
                                                                        BorderThickness="0,0,0,1" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ItemsControl
                                                            Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}"
                                                            ItemsSource="{Binding TimedTaskBlocks}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        Width="{Binding Width}"
                                                                        Height="{Binding Height}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Style="{StaticResource FlatButtonStyle}"
                                                                        VerticalContentAlignment="Stretch"
                                                                        Click="WeekTimedTaskButton_Click">
                                                                        <Button.RenderTransform>
                                                                            <TranslateTransform
                                                                                X="{Binding Left}"
                                                                                Y="{Binding Top}" />
                                                                        </Button.RenderTransform>
                                                                            <Border
                                                                                Padding="{Binding ContentPadding}"
                                                                                Background="{Binding BackgroundBrush}"
                                                                                BorderBrush="{Binding BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="10"
                                                                                Opacity="{Binding ContentOpacity}">
                                                                                <Grid RowSpacing="2">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="*" />
                                                                                    </Grid.RowDefinitions>

                                                                                    <TextBlock
                                                                                        FontSize="{Binding TimeFontSize}"
                                                                                        Foreground="{Binding AccentBrush}"
                                                                                        Text="{Binding TimeText}" />
                                                                                    <TextBlock
                                                                                        Grid.Row="1"
                                                                                        FontSize="{Binding TitleFontSize}"
                                                                                        FontWeight="SemiBold"
                                                                                        MaxLines="{Binding TitleMaxLines}"
                                                                                        Text="{Binding Title}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        TextWrapping="{Binding TitleWrapping}" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                IsHitTestVisible="False"
                                Height="2"
                                Margin="4,0,4,0"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AppAccentBrush}"
                                CornerRadius="999"
                                Opacity="1"
                                Visibility="{Binding CurrentWeekTimeIndicatorVisibility}">
                                <Border.RenderTransform>
                                    <TranslateTransform
                                        Y="{Binding CurrentWeekTimeIndicatorTop}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource AppShellBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18">
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="{Binding EmptySelectedTaskVisibility}">
                            <Border
                                Width="52"
                                Height="52"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource AppAccentMutedBrush}"
                                CornerRadius="999">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="18"
                                    Foreground="{ThemeResource AppAccentBrush}"
                                    Glyph="&#xE8A5;" />
                            </Border>

                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="22"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="Week editor" />
                            <TextBlock
                                Width="240"
                                TextAlignment="Center"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Click an existing task to edit it, or click empty space in the week timeline to create a new one."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding SelectedTaskVisibility}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontFamily="Segoe UI Variable Display"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="{Binding EditorPanelTitle}" />
                                        <TextBlock
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            Text="{Binding EditorScheduleSummary}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            Text="{Binding EditorPanelSubtitle}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="CloseEditorButton_Click"
                                        ToolTipService.ToolTip="Close editor">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>

                                <TextBox
                                    Header="Title"
                                    PlaceholderText="What needs to be done?"
                                    Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <DatePicker
                                    Header="Date"
                                    Date="{Binding EditorDate, Mode=TwoWay}" />

                                <Border
                                    Background="{ThemeResource AppPageBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="Time" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="Enable timed placement on the week timeline" />
                                            </StackPanel>

                                            <ToggleSwitch
                                                Grid.Column="1"
                                                IsOn="{Binding EditorHasTime, Mode=TwoWay}"
                                                OffContent="Any"
                                                OnContent="Set" />
                                        </Grid>

                                        <TimePicker
                                            ClockIdentifier="24HourClock"
                                            Header="Start"
                                            IsEnabled="{Binding EditorHasTime}"
                                            MinuteIncrement="5"
                                            Time="{Binding EditorTime, Mode=TwoWay}" />

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="Duration" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="Optional block length for the timeline" />
                                            </StackPanel>

                                            <ToggleSwitch
                                                Grid.Column="1"
                                                IsEnabled="{Binding EditorDurationToggleEnabled}"
                                                IsOn="{Binding EditorHasDuration, Mode=TwoWay}"
                                                OffContent="Off"
                                                OnContent="Set" />
                                        </Grid>

                                        <NumberBox
                                            Header="Minutes"
                                            IsEnabled="{Binding EditorDurationInputEnabled}"
                                            LargeChange="15"
                                            Maximum="{Binding EditorMaxDurationMinutes}"
                                            Minimum="5"
                                            SmallChange="5"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding EditorDurationMinutes, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="10">
                                    <Button
                                        Style="{StaticResource PrimaryToolbarButtonStyle}"
                                        Click="SaveTaskButton_Click"
                                        Content="{Binding EditorPrimaryActionText}" />

                                    <Button
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="CompleteTaskButton_Click"
                                        Content="{Binding EditorCompletionButtonText}"
                                        Visibility="{Binding EditorCompleteVisibility}" />

                                    <Button
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="DeleteSelectedTaskButton_Click"
                                        Content="Delete task"
                                        Visibility="{Binding EditorDeleteVisibility}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
