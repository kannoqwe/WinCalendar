<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CompactActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppCardAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="CompactArrowButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextMutedBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Loaded="Root_Loaded" Padding="{Binding CompactPanelRootPadding}">
        <Border
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding CompactPanelCornerRadius}"
            Padding="12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="ToggleSidebarButton_Click"
                        ToolTipService.ToolTip="Toggle tasks list">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE700;" />
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding MonthLabel}" />
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource CompactArrowButtonStyle}"
                        Click="PreviousMonthButton_Click"
                        ToolTipService.ToolTip="Previous month">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource CompactArrowButtonStyle}"
                        Click="NextMonthButton_Click"
                        ToolTipService.ToolTip="Next month">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="AddTaskButton_Click"
                        ToolTipService.ToolTip="Add task">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        Grid.Column="5"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="OpenFullButton_Click"
                        ToolTipService.ToolTip="Open app">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE80F;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="{Binding SelectedDateText}" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Center" Text="Mo" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="Tu" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="We" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="Th" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="Fr" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Center" Text="Sa" />
                    <TextBlock Grid.Column="6" HorizontalAlignment="Center" Text="Su" />
                </Grid>

                <GridView
                    Grid.Row="3"
                    ItemsSource="{Binding MonthDays}"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Width" Value="48" />
                            <Setter Property="Height" Value="42" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource FlatButtonStyle}"
                                Click="MonthDayButton_Click"
                                DoubleTapped="MonthDayButton_DoubleTapped">
                                <Grid Opacity="{Binding DayOpacity}">
                                    <Border
                                        Visibility="{Binding CompactSelectionVisibility}"
                                        Background="{ThemeResource AppAccentMutedBrush}"
                                        CornerRadius="12" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                        <Grid>
                                            <TextBlock
                                                Visibility="{Binding CompactNormalNumberVisibility}"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding DayButtonText}" />
                                            <TextBlock
                                                Visibility="{Binding CompactTodayNumberVisibility}"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppAccentBrush}"
                                                Text="{Binding DayButtonText}" />
                                        </Grid>
                                        <Border
                                            Visibility="{Binding TaskIndicatorVisibility}"
                                            Width="6"
                                            Height="6"
                                            Background="{Binding IndicatorBrush}"
                                            CornerRadius="999" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Border>
    </Grid>
</Page>
