<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinCalendar.Modules.Planner.UI.TaskComposerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Width="300" Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                FontFamily="Segoe UI Variable Display"
                FontSize="20"
                FontWeight="SemiBold"
                Text="New task" />
            <TextBlock
                x:Name="SubtitleTextBlock"
                FontSize="12"
                Foreground="{ThemeResource AppTextMutedBrush}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <TextBox
            x:Name="TitleTextBox"
            PlaceholderText="Task title"
            TextChanged="TitleTextBox_TextChanged" />

        <DatePicker
            x:Name="TaskDatePicker"
            Header="Date"
            DateChanged="TaskDatePicker_DateChanged" />

        <Border
            Background="{ThemeResource AppShellBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="Time" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="Place task on the timeline" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="HasTimeToggle"
                        Grid.Column="1"
                        OffContent="Any"
                        OnContent="Set"
                        Toggled="HasTimeToggle_Toggled" />
                </Grid>

                <TimePicker
                    x:Name="TaskTimePicker"
                    ClockIdentifier="24HourClock"
                    Header="Start"
                    MinuteIncrement="5"
                    Visibility="Collapsed"
                    TimeChanged="TaskTimePicker_TimeChanged" />
            </StackPanel>
        </Border>

        <Border
            Background="{ThemeResource AppShellBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="Duration" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="Optional block length" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="HasDurationToggle"
                        Grid.Column="1"
                        IsEnabled="False"
                        OffContent="Off"
                        OnContent="Set"
                        Toggled="HasDurationToggle_Toggled" />
                </Grid>

                <NumberBox
                    x:Name="TaskDurationNumberBox"
                    Header="Minutes"
                    LargeChange="15"
                    Minimum="5"
                    SmallChange="5"
                    SpinButtonPlacementMode="Compact"
                    Visibility="Collapsed"
                    ValueChanged="TaskDurationNumberBox_ValueChanged" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
