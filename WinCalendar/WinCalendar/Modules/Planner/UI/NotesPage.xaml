<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Border
            Margin="24"
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24">
            <StackPanel Spacing="8">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Text="Notes" />
                <TextBlock
                    Foreground="{ThemeResource AppTextMutedBrush}"
                    Text="This module is reserved for a future notes workflow." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
