<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="CompactAccentBrush" Color="#FFFF00FF" />
        <SolidColorBrush x:Key="CompactDividerBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactMutedBrush" Color="#8A000000" />
        <SolidColorBrush x:Key="CompactPanelBrush" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="CompactTaskCardBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactTextBrush" Color="#FF1C1C1C" />

        <Style x:Key="CompactNewTaskButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource CompactAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="CompactTaskItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="Root"
        Loaded="Root_Loaded"
        Unloaded="Root_Unloaded">
        <Border
            Width="360"
            HorizontalAlignment="Stretch"
            Background="{StaticResource CompactPanelBrush}"
            BorderBrush="{StaticResource CompactDividerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="132" />
                </Grid.RowDefinitions>

                <CalendarView
                    x:Name="CompactCalendarView"
                    Width="332"
                    Height="306"
                    HorizontalAlignment="Center"
                    CalendarViewDayItemChanging="CompactCalendarView_CalendarViewDayItemChanging"
                    DisplayMode="Month"
                    FirstDayOfWeek="Monday"
                    IsOutOfScopeEnabled="True"
                    IsTodayHighlighted="True"
                    MaxWidth="332"
                    MinWidth="332"
                    SelectedDatesChanged="CompactCalendarView_SelectedDatesChanged"
                    SelectionMode="Single" />

                <Border
                    Grid.Row="1"
                    Height="1"
                    Background="{StaticResource CompactDividerBrush}" />

                <Grid
                    Grid.Row="2"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource CompactAccentBrush}"
                        Text="TODAY TASKS" />

                    <Button
                        Grid.Column="1"
                        Click="AddTaskButton_Click"
                        Content="+ NEW"
                        Style="{StaticResource CompactNewTaskButtonStyle}" />
                </Grid>

                <ListView
                    Grid.Row="3"
                    Height="132"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource CompactTaskItemContainerStyle}"
                    ItemsSource="{Binding TodayTasks}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="58"
                                Margin="0,0,0,8"
                                Padding="10,7"
                                Background="{StaticResource CompactTaskCardBrush}"
                                BorderBrush="{StaticResource CompactAccentBrush}"
                                BorderThickness="2,0,0,0"
                                CornerRadius="6"
                                Opacity="{Binding ContentOpacity}">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource CompactTextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="11"
                                        Foreground="{StaticResource CompactMutedBrush}"
                                        Text="{Binding CompactTimeText}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
