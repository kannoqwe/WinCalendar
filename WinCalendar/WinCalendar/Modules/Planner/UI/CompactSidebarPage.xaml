<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactSidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Loaded="Root_Loaded" Padding="10,10,0,10">
        <Border
            Background="{ThemeResource AppSidebarBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding CompactSidebarCornerRadius}"
            Padding="12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Tasks" />

                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="FROM TODAY" />
                    <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding WeekSummary}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBlock
                        Visibility="{Binding EmptyWeekAgendaVisibility}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="No tasks scheduled for the rest of this week."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />

                    <ScrollViewer
                        Visibility="{Binding WeekAgendaVisibility}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemsSource="{Binding WeekAgendaDays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12" Spacing="8">
                                        <Button
                                            Style="{StaticResource FlatButtonStyle}"
                                            Click="AgendaDayHeaderButton_Click">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Glyph="{Binding CompactChevronGlyph}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding CompactHeaderLabel}" />
                                                </Grid>
                                                <TextBlock
                                                    Margin="20,0,0,0"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="{Binding CompactHeaderDetails}" />
                                            </StackPanel>
                                        </Button>

                                        <Border
                                            Visibility="{Binding ContentVisibility}"
                                            Margin="18,0,0,0"
                                            Padding="10,0,0,0"
                                            BorderBrush="{ThemeResource AppLineBrush}"
                                            BorderThickness="1,0,0,0">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    Visibility="{Binding EmptyTasksVisibility}"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="{Binding EmptyTasksText}"
                                                    TextWrapping="WrapWholeWords" />
                                                <ItemsControl
                                                    Visibility="{Binding TasksVisibility}"
                                                    ItemsSource="{Binding Tasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid
                                                                Margin="0,0,0,8"
                                                                ColumnSpacing="10"
                                                                Opacity="{Binding ContentOpacity}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox
                                                                    VerticalAlignment="Top"
                                                                    IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                                    Click="AgendaTaskCompletionCheckBox_Click" />

                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="2">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding Title}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource AppTextMutedBrush}"
                                                                        Text="{Binding CompactTimeText}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
