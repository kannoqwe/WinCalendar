<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="CompactGlassBrush" Color="#DFFFFFFF" />
        <SolidColorBrush x:Key="CompactHairlineBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactTaskCardBrush" Color="#12000000" />
        <SolidColorBrush x:Key="CompactTextBrush" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="CompactMutedTextBrush" Color="#66000000" />
        <ThemeShadow x:Key="CompactPanelShadow" />

        <Style x:Key="FlatCompactButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="AccentCompactButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompactNavButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#0A000000" />
            <Setter Property="BorderBrush" Value="{StaticResource CompactHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource CompactTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Loaded="Root_Loaded" Padding="10">
        <Border
            Background="{StaticResource CompactGlassBrush}"
            BorderBrush="{StaticResource CompactHairlineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18"
            Shadow="{StaticResource CompactPanelShadow}"
            Translation="0,0,32">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource CompactTextBrush}"
                    Text="{Binding MonthLabel}" />

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x41F;&#x43D;" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x412;&#x442;" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x421;&#x440;" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x427;&#x442;" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x41F;&#x442;" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x421;&#x431;" />
                    <TextBlock Grid.Column="6" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CompactMutedTextBrush}" Text="&#x412;&#x441;" />
                </Grid>

                <GridView
                    Grid.Row="2"
                    Margin="-2,0"
                    Height="238"
                    ItemsSource="{Binding MonthDays}"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Width" Value="42" />
                            <Setter Property="Height" Value="34" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource FlatCompactButtonStyle}"
                                Click="MonthDayButton_Click"
                                DoubleTapped="MonthDayButton_DoubleTapped">
                                <Grid Opacity="{Binding DayOpacity}">
                                    <Border
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource AppAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Visibility="{Binding CompactTodayRingVisibility}" />
                                    <Border
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AppAccentBrush}"
                                        CornerRadius="14"
                                        Visibility="{Binding CompactSelectedCircleVisibility}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource CompactTextBrush}"
                                        Text="{Binding DayButtonText}"
                                        Visibility="{Binding CompactUnselectedNumberVisibility}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding DayButtonText}"
                                        Visibility="{Binding CompactSelectedNumberVisibility}" />
                                    <Border
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{Binding IndicatorBrush}"
                                        CornerRadius="2"
                                        Visibility="{Binding TaskIndicatorVisibility}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    Grid.Row="3"
                    Height="1"
                    Background="{StaticResource CompactHairlineBrush}" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource CompactTextBrush}"
                        Text="&#x417;&#x430;&#x434;&#x430;&#x447;&#x438; &#x43D;&#x430; &#x441;&#x435;&#x433;&#x43E;&#x434;&#x43D;&#x44F;" />

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource AccentCompactButtonStyle}"
                        Click="AddTaskButton_Click"
                        Content="+ &#x41D;&#x43E;&#x432;&#x430;&#x44F;" />
                </Grid>

                <ListView
                    Grid.Row="5"
                    Margin="-2,0"
                    Padding="0"
                    ItemsSource="{Binding CompactVisibleTodayTasks}"
                    SelectionMode="None"
                    Visibility="{Binding CompactTaskListVisibility}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinHeight="56"
                                Background="{StaticResource CompactTaskCardBrush}"
                                BorderBrush="{StaticResource CompactHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Background="{ThemeResource AppAccentBrush}"
                                        CornerRadius="8,0,0,8" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Padding="10,8"
                                        Opacity="{Binding ContentOpacity}"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource CompactTextBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource CompactMutedTextBrush}"
                                            Text="{Binding CompactTimeText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <CheckBox
                                        Grid.Column="2"
                                        Margin="6,0,8,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                        Click="CompactTaskCompletionCheckBox_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource CompactMutedTextBrush}"
                    Text="&#x41D;&#x430; &#x441;&#x435;&#x433;&#x43E;&#x434;&#x43D;&#x44F; &#x437;&#x430;&#x434;&#x430;&#x447; &#x43D;&#x435;&#x442;"
                    Visibility="{Binding CompactEmptyTasksVisibility}" />

                <Grid
                    Grid.Row="6"
                    Visibility="{Binding CompactTaskNavigationVisibility}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Style="{StaticResource CompactNavButtonStyle}"
                            IsEnabled="{Binding CanGoToPreviousCompactTaskPage}"
                            Click="PreviousTaskPageButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76B;" />
                        </Button>
                        <TextBlock
                            MinWidth="30"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource CompactMutedTextBrush}"
                            Text="{Binding CompactTaskPageText}"
                            TextAlignment="Center" />
                        <Button
                            Style="{StaticResource CompactNavButtonStyle}"
                            IsEnabled="{Binding CanGoToNextCompactTaskPage}"
                            Click="NextTaskPageButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
