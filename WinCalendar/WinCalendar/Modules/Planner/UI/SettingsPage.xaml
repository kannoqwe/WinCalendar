<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Border
            Margin="24"
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24">
            <StackPanel Spacing="16">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <TextBlock
                    Foreground="{ThemeResource AppTextMutedBrush}"
                    Text="Current UI defaults:" />
                <TextBlock Text="Date format: DD.MM.YYYY" />
                <TextBlock Text="Time format: 24h" />
                <TextBlock Text="Compact panel stays connected to the full app through shared state." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
