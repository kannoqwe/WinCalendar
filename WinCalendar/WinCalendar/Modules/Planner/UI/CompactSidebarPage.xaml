<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactSidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Loaded="Root_Loaded" Padding="10,10,0,10">
        <Border
            Background="{ThemeResource AppSidebarBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding CompactSidebarCornerRadius}"
            Padding="12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Tasks" />
                    <Button
                        Grid.Column="1"
                        MinWidth="54"
                        Click="ToggleSidebarButton_Click"
                        Content="Close" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="THIS WEEK" />
                    <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding WeekSummary}" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <ItemsControl ItemsSource="{Binding WeekAgendaDays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="8"
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Style="{StaticResource FlatButtonStyle}"
                                            Click="AgendaDayHeaderButton_Click"
                                            Content="{Binding HeaderText}" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Padding="6,2"
                                            Background="{ThemeResource AppAccentMutedBrush}"
                                            CornerRadius="999"
                                            VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Text="{Binding CountBadgeText}" />
                                        </Border>
                                        <Button
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            MinWidth="28"
                                            Click="AgendaDayExpandButton_Click"
                                            Content="{Binding CompactExpandButtonText}" />
                                        <Button
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            MinWidth="42"
                                            Click="AgendaDayHideButton_Click"
                                            Content="{Binding HideButtonText}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="4"
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            MaxLines="1"
                                            Text="{Binding CompactPreviewText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.ColumnSpan="4"
                                            Visibility="{Binding CompactOverflowVisibility}"
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            Text="{Binding CompactOverflowText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
