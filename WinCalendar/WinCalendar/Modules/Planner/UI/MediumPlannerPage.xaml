<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.MediumPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Loaded="Root_Loaded"
        Padding="16">
        <Border
            Background="{ThemeResource AppShellBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Click="PreviousDayButton_Click" Content="&#xE100;" FontFamily="Segoe Fluent Icons" />
                        <Button Grid.Column="1" Click="NextDayButton_Click" Content="&#xE101;" FontFamily="Segoe Fluent Icons" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedDateText}" />
                            <TextBlock
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding SelectedDateSummary}" />
                        </StackPanel>
                        <Button Grid.Column="3" Click="OpenFullButton_Click" Content="Open app" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="DAY TASKS" />
                            <TextBox
                                x:Name="QuickAddTitleTextBox"
                                Header="Quick add"
                                KeyDown="QuickAddTitleTextBox_KeyDown"
                                PlaceholderText="Task title" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch x:Name="QuickAddUseTimeToggle" Header="Use time" />
                                <TimePicker Grid.Column="1" x:Name="QuickAddTimePicker" IsEnabled="{Binding IsOn, ElementName=QuickAddUseTimeToggle}" />
                                <Button Grid.Column="2" Click="QuickAddButton_Click" Content="Add" />
                            </Grid>
                        </StackPanel>

                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding SelectedDayTasks}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Click="TaskCardButton_Click">
                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource AppCardBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Opacity="{Binding ContentOpacity}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    VerticalAlignment="Top"
                                                    IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                    Click="TaskCompletionCheckBox_Click" />

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding DetailsText}" />
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="2"
                                                    Click="DeleteTaskButton_Click"
                                                    Content="Delete" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16">
                    <Grid>
                        <Grid Visibility="{Binding EmptySelectedTaskVisibility}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Select a task to view details." />
                        </Grid>

                        <ScrollViewer Visibility="{Binding SelectedTaskVisibility}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Text="Task details" />

                                <TextBox
                                    Header="Title"
                                    Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <DatePicker
                                    Header="Date"
                                    Date="{Binding EditorDate, Mode=TwoWay}" />

                                <ToggleSwitch
                                    Header="Use time"
                                    IsOn="{Binding EditorHasTime, Mode=TwoWay}" />

                                <TimePicker
                                    Header="Time"
                                    IsEnabled="{Binding EditorHasTime}"
                                    Time="{Binding EditorTime, Mode=TwoWay}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Background="{ThemeResource AppAccentBrush}"
                                        Click="SaveTaskButton_Click"
                                        Content="Save"
                                        Foreground="White" />

                                    <Button
                                        Grid.Column="1"
                                        Click="CompleteTaskButton_Click"
                                        Content="Toggle done" />

                                    <Button
                                        Grid.Column="2"
                                        Click="DeleteSelectedTaskButton_Click"
                                        Content="Delete" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
