<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="Root"
        Loaded="Root_Loaded"
        Padding="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Visibility="{Binding CompactSidebarVisibility}"
                Background="{ThemeResource AppSidebarBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="TODAY" />
                        <TextBlock Text="{Binding TodaySummary}" />

                        <ItemsControl ItemsSource="{Binding TodayTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Opacity="{Binding ContentOpacity}">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding TimeText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="THIS WEEK" />
                        <TextBlock Text="{Binding WeekSummary}" />

                        <ItemsControl ItemsSource="{Binding WeekAgendaDays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10">
                                        <StackPanel Spacing="8">
                                            <Border
                                                Visibility="{Binding SelectionVisibility}"
                                                Background="{ThemeResource AppAccentMutedBrush}"
                                                CornerRadius="10"
                                                Height="4" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button
                                                    Style="{StaticResource FlatButtonStyle}"
                                                    Click="AgendaDayHeaderButton_Click"
                                                    Content="{Binding HeaderText}" />

                                                <Button
                                                    Grid.Column="1"
                                                    Click="AgendaDayExpandButton_Click"
                                                    Content="{Binding ExpandButtonText}" />

                                                <Button
                                                    Grid.Column="2"
                                                    Click="AgendaDayHideButton_Click"
                                                    Content="{Binding HideButtonText}" />
                                            </Grid>

                                            <TextBlock
                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                Text="{Binding SummaryText}" />

                                            <TextBlock
                                                Visibility="{Binding HiddenVisibility}"
                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                Text="Day hidden in compact sidebar." />

                                            <ItemsControl
                                                Visibility="{Binding ContentVisibility}"
                                                ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="8"
                                                            Background="{ThemeResource AppCardAltBackgroundBrush}"
                                                            CornerRadius="10">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock MaxLines="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding TimeText}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Click="ToggleSidebarButton_Click"
                            Content="{Binding CompactSidebarToggleText}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding MonthLabel}" />

                        <Button
                            Grid.Column="2"
                            Click="OpenMediumButton_Click"
                            Content="Medium" />

                        <Button
                            Grid.Column="3"
                            Click="OpenFullButton_Click"
                            Content="Full" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Click="PreviousMonthButton_Click" Content="&#xE100;" FontFamily="Segoe Fluent Icons" />
                        <Button Grid.Column="1" Click="NextMonthButton_Click" Content="&#xE101;" FontFamily="Segoe Fluent Icons" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="{Binding SelectedDateText}" />
                        <Button Grid.Column="3" Click="TodayButton_Click" Content="Today" />
                    </Grid>

                    <Grid Grid.Row="2" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock HorizontalAlignment="Center" Text="Mo" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="Tu" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="We" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="Th" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="Fr" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Center" Text="Sa" />
                            <TextBlock Grid.Column="6" HorizontalAlignment="Center" Text="Su" />
                        </Grid>

                        <GridView
                            Grid.Row="1"
                            ItemsSource="{Binding MonthDays}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>

                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Width" Value="46" />
                                    <Setter Property="Height" Value="54" />
                                </Style>
                            </GridView.ItemContainerStyle>

                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Style="{StaticResource FlatButtonStyle}"
                                        Click="MonthDayButton_Click">
                                        <Grid Opacity="{Binding DayOpacity}">
                                            <Border
                                                Visibility="{Binding SelectionVisibility}"
                                                Background="{ThemeResource AppAccentMutedBrush}"
                                                CornerRadius="12" />
                                            <Border
                                                Visibility="{Binding TodayVisibility}"
                                                BorderBrush="{ThemeResource AppAccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding DayButtonText}" />
                                                <Border
                                                    Visibility="{Binding TaskIndicatorVisibility}"
                                                    Width="8"
                                                    Height="8"
                                                    Background="{Binding IndicatorBrush}"
                                                    CornerRadius="999" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Border
                            Grid.Row="2"
                            Background="{ThemeResource AppCardAltBackgroundBrush}"
                            CornerRadius="14"
                            Padding="12">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedDateText}" />
                                    <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding SelectedDateSummary}" />
                                </StackPanel>

                                <ListView
                                    Grid.Row="1"
                                    ItemsSource="{Binding SelectedDayTasks}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="10"
                                                Background="{ThemeResource AppCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Opacity="{Binding ContentOpacity}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        VerticalAlignment="Top"
                                                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                        Click="CompactTaskCompletionCheckBox_Click" />

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock Foreground="{ThemeResource AppTextMutedBrush}" Text="{Binding DetailsText}" />
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="2"
                                                        Click="CompactOpenTaskButton_Click"
                                                        Content="Open" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
