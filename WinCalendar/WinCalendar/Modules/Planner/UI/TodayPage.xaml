<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppPageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="HeaderToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="HeaderPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Loaded="Root_Loaded"
        Padding="16">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="0,0,0,12"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="WEEK" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding MonthLabel}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2"
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding WeekLabel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="PreviousWeekButton_Click"
                            ToolTipService.ToolTip="Previous week">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76B;" />
                        </Button>

                        <Button
                            Style="{StaticResource HeaderToolbarButtonStyle}"
                            Click="CurrentWeekButton_Click"
                            Content="Today" />

                        <Button
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="NextWeekButton_Click"
                            ToolTipService.ToolTip="Next week">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76C;" />
                        </Button>

                        <Button
                            Style="{StaticResource HeaderPrimaryButtonStyle}"
                            Click="AddTaskButton_Click"
                            Content="New task" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="256" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="WEEK" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding WeekViewSummary}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="Click empty space to add a task" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource AppCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="12,10,8,10"
                                Background="{ThemeResource AppPageBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="0,0,1,1">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="TIME" />
                            </Border>

                            <ScrollViewer
                                x:Name="WeekTimelineHeaderScrollViewer"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                ViewChanged="WeekTimelineStickyScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{Binding WeekTimelineDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Style="{StaticResource FlatButtonStyle}"
                                                Click="WeekDayHeaderButton_Click"
                                                ToolTipService.ToolTip="{Binding FullDateText}">
                                                <Grid
                                                    Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                                    Height="60"
                                                    Background="{ThemeResource AppPageBackgroundBrush}">
                                                    <Border
                                                        Visibility="{Binding SelectionVisibility}"
                                                        Background="{ThemeResource AppAccentMutedBrush}"
                                                        Opacity="0.5" />
                                                    <Border
                                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                                        BorderThickness="0,0,1,1" />
                                                    <Border
                                                        Width="3"
                                                        HorizontalAlignment="Left"
                                                        Background="{ThemeResource AppAccentBrush}"
                                                        Visibility="{Binding SelectionVisibility}" />

                                                    <Grid
                                                        Padding="12,10"
                                                        ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                                Text="{Binding DayNameText}" />
                                                            <TextBlock
                                                                FontFamily="Segoe UI Variable Display"
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DayNumberText}" />
                                                        </StackPanel>

                                                        <Border
                                                            Grid.Column="1"
                                                            Width="8"
                                                            Height="8"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource AppAccentBrush}"
                                                            CornerRadius="999"
                                                            Visibility="{Binding TodayVisibility}" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Height="{Binding WeekTimelineAnyTimeLaneHeight}"
                                Padding="12,10,8,8"
                                Background="{ThemeResource AppPageBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="0,0,1,1">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="ALL DAY" />
                            </Border>

                            <ScrollViewer
                                x:Name="WeekTimelineAllDayScrollViewer"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                ViewChanged="WeekTimelineStickyScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{Binding WeekTimelineDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                                Height="{Binding DataContext.WeekTimelineAnyTimeLaneHeight, ElementName=LayoutRoot}"
                                                Background="{ThemeResource AppCardBackgroundBrush}">
                                                <Border
                                                    Visibility="{Binding SelectionVisibility}"
                                                    Background="{ThemeResource AppAccentMutedBrush}"
                                                    Opacity="0.16" />
                                                <Border
                                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                                    BorderThickness="0,0,1,1" />

                                                <Grid
                                                    Background="Transparent"
                                                    Tapped="WeekAllDayLane_Tapped">
                                                    <Grid Padding="6,6,4,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock
                                                            Visibility="{Binding EmptyAllDayVisibility}"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Text="Add task" />

                                                        <ScrollViewer
                                                            Grid.Row="1"
                                                            Margin="0,4,0,0"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            VerticalScrollBarVisibility="Auto"
                                                            VerticalScrollMode="Enabled"
                                                            ZoomMode="Disabled">
                                                            <ItemsControl ItemsSource="{Binding VisibleAllDayTasks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button
                                                                            Margin="0,0,0,2"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Style="{StaticResource FlatButtonStyle}"
                                                                            Click="WeekAllDayTaskButton_Click">
                                                                            <Border
                                                                                Padding="5,2"
                                                                                Background="{Binding TaskBackgroundBrush}"
                                                                                BorderBrush="{Binding TaskBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="5"
                                                                                Opacity="{Binding ContentOpacity}">
                                                                                <TextBlock
                                                                                    FontSize="10"
                                                                                    FontWeight="SemiBold"
                                                                                    Text="{Binding Title}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </Border>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer
                                x:Name="WeekTimelineHoursScrollViewer"
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                ViewChanged="WeekTimelineHoursScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{Binding WeekTimelineHours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}"
                                                Padding="12,6,8,0"
                                                Background="{ThemeResource AppPageBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="0,0,1,1">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="{Binding LabelText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer
                                x:Name="WeekTimelineScrollViewer"
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                ViewChanged="WeekTimelineScrollViewer_ViewChanged">
                                <Grid x:Name="WeekTimelineContentGrid">
                                    <ItemsControl ItemsSource="{Binding WeekTimelineDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                                    Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}"
                                                    Background="{ThemeResource AppCardBackgroundBrush}">
                                                    <Border
                                                        Visibility="{Binding SelectionVisibility}"
                                                        Background="{ThemeResource AppAccentMutedBrush}"
                                                        Opacity="0.16" />
                                                    <Border
                                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                                        BorderThickness="0,0,1,0" />

                                                    <Grid>
                                                        <Border
                                                            Background="Transparent"
                                                            Tapped="WeekTimedGrid_Tapped" />

                                                        <ItemsControl
                                                            IsHitTestVisible="False"
                                                            ItemsSource="{Binding DataContext.WeekTimelineHours, ElementName=LayoutRoot}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}"
                                                                        BorderBrush="{ThemeResource AppLineBrush}"
                                                                        BorderThickness="0,0,0,1" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ItemsControl
                                                            Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}"
                                                            ItemsSource="{Binding TimedTaskBlocks}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        Width="{Binding Width}"
                                                                        Height="{Binding Height}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Style="{StaticResource FlatButtonStyle}"
                                                                        VerticalContentAlignment="Stretch"
                                                                        Click="WeekTimedTaskButton_Click">
                                                                        <Button.RenderTransform>
                                                                            <TranslateTransform
                                                                                X="{Binding Left}"
                                                                                Y="{Binding Top}" />
                                                                        </Button.RenderTransform>
                                                                        <Border
                                                                            Padding="{Binding ContentPadding}"
                                                                            Background="{Binding BackgroundBrush}"
                                                                            BorderBrush="{Binding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Opacity="{Binding ContentOpacity}">
                                                                            <Grid ColumnSpacing="5">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <Border
                                                                                    Margin="0,1,0,1"
                                                                                    Background="{Binding AccentBrush}"
                                                                                    CornerRadius="2" />

                                                                                <Grid
                                                                                    Grid.Column="1"
                                                                                    RowSpacing="0">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="*" />
                                                                                    </Grid.RowDefinitions>

                                                                                    <TextBlock
                                                                                        FontSize="{Binding TitleFontSize}"
                                                                                        FontWeight="SemiBold"
                                                                                        MaxLines="{Binding TitleMaxLines}"
                                                                                        Text="{Binding Title}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        TextWrapping="{Binding TitleWrapping}" />

                                                                                    <TextBlock
                                                                                        Grid.Row="1"
                                                                                        FontSize="{Binding TimeFontSize}"
                                                                                        Foreground="{Binding AccentBrush}"
                                                                                        Text="{Binding BottomTimeText}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border
                                        IsHitTestVisible="False"
                                        Height="2"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AppAccentBrush}"
                                        Opacity="1"
                                        Visibility="{Binding CurrentWeekTimeIndicatorVisibility}">
                                        <Border.RenderTransform>
                                            <TranslateTransform
                                                Y="{Binding CurrentTimeIndicatorTop}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Margin="0,2,0,2"
                        Background="{ThemeResource AppBorderBrush}" />

                    <Grid
                        Grid.Column="1"
                        Padding="18,0,0,0"
                        RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="EDITOR" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding SelectedDateText}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <StackPanel
                                Spacing="10"
                                Visibility="{Binding EmptySelectedTaskVisibility}">
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="No task selected" />
                                <TextBlock
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="Select a task in the week grid or click an empty slot to create a new one."
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource HeaderPrimaryButtonStyle}"
                                    Click="AddTaskButton_Click"
                                    Content="New task" />
                            </StackPanel>

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding SelectedTaskVisibility}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                Text="TASK" />
                                            <TextBox
                                                x:Name="EditorTitleTextBox"
                                                Padding="0,0,0,6"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="Segoe UI Variable Display"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                PlaceholderText="Untitled"
                                                Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextChanged="EditorTitleTextBox_TextChanged"
                                                LostFocus="EditorTitleTextBox_LostFocus" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource HeaderIconButtonStyle}"
                                            Click="CloseEditorButton_Click"
                                            ToolTipService.ToolTip="Close editor">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>

                                    <Border
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="0,1,0,0" />

                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            Text="SCHEDULE" />

                                        <CalendarDatePicker
                                            x:Name="EditorDatePicker"
                                            Date="{Binding EditorDate, Mode=TwoWay}"
                                            DateChanged="EditorDatePicker_DateChanged"
                                            Header="Date"
                                            HorizontalAlignment="Stretch" />

                                        <CheckBox
                                            Content="Time"
                                            IsChecked="{Binding EditorHasTime, Mode=TwoWay}"
                                            Click="EditorTimeToggle_Click" />

                                        <StackPanel
                                            Spacing="6"
                                            Visibility="{Binding EditorTimeVisibility}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                Text="Start" />
                                            <Button
                                                x:Name="EditorTimeButton"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource HeaderToolbarButtonStyle}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Glyph="&#xE823;" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding EditorTimeText}" />
                                                    </StackPanel>

                                                    <FontIcon
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource AppTextMutedBrush}"
                                                        Glyph="&#xE70D;" />
                                                </Grid>

                                                <Button.Flyout>
                                                    <Flyout
                                                        x:Name="EditorTimeFlyout"
                                                        Opening="EditorTimeFlyout_Opening"
                                                        Placement="BottomEdgeAlignedLeft">
                                                        <Border
                                                            Width="108"
                                                            Padding="6"
                                                            Background="{ThemeResource AppShellBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                            <ListView
                                                                x:Name="EditorTimeListView"
                                                                IsItemClickEnabled="True"
                                                                ItemsSource="{x:Bind EditorTimeOptions}"
                                                                ItemClick="EditorTimeListView_ItemClick"
                                                                MaxHeight="220"
                                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                                SelectionMode="Single">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock
                                                                            Padding="6,4"
                                                                            FontSize="13"
                                                                            Text="{Binding}" />
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>

                                        <CheckBox
                                            Content="Duration"
                                            IsChecked="{Binding EditorHasDuration, Mode=TwoWay}"
                                            Click="EditorDurationToggle_Click"
                                            IsEnabled="{Binding EditorDurationToggleEnabled}" />

                                        <NumberBox
                                            x:Name="EditorDurationNumberBox"
                                            Header="Minutes"
                                            IsEnabled="{Binding EditorDurationInputEnabled}"
                                            LargeChange="15"
                                            Maximum="{Binding EditorMaxDurationMinutes}"
                                            Minimum="15"
                                            SmallChange="15"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding EditorDurationMinutes, Mode=TwoWay}"
                                            ValueChanged="EditorDurationNumberBox_ValueChanged"
                                            Visibility="{Binding EditorDurationVisibility}" />
                                    </StackPanel>

                                    <Border
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="0,1,0,0" />

                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            Text="ACTIONS" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Style="{StaticResource HeaderToolbarButtonStyle}"
                                                Click="CompleteTaskButton_Click"
                                                Visibility="{Binding EditorCompleteVisibility}">
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" />
                                                    <TextBlock Text="{Binding EditorCompletionButtonText}" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Grid.Column="1"
                                                Style="{StaticResource HeaderIconButtonStyle}"
                                                Click="DeleteSelectedTaskButton_Click"
                                                Visibility="{Binding EditorDeleteVisibility}">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
