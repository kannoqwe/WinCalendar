<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="CompactDividerBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactMutedBrush" Color="#8A000000" />
        <SolidColorBrush x:Key="CompactComposerPanelBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CompactPanelBrush" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="CompactTaskCardBrush" Color="#0D000000" />
        <SolidColorBrush x:Key="CompactTextBrush" Color="#FF1C1C1C" />

        <Style x:Key="CompactNewTaskButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="CompactMonthNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource CompactTextBrush}" />
        </Style>

        <Style x:Key="CompactOpenMainAppButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource CompactTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompactDayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CompactTaskItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="CompactTaskCompletionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>

        <Style x:Key="CompactComposerFieldButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource CompactTaskCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CompactDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource CompactTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CompactComposerSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource CompactMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompactComposerPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="Root"
        KeyDown="Root_KeyDown"
        Loaded="Root_Loaded">
        <Border
            x:Name="PanelHost"
            Width="360"
            HorizontalAlignment="Stretch"
            Background="{StaticResource CompactPanelBrush}"
            BorderBrush="{StaticResource CompactDividerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
            <Border.RenderTransform>
                <CompositeTransform
                    x:Name="PanelHostTransform"
                    CenterX="180"
                    CenterY="536"
                    ScaleX="0.98"
                    ScaleY="0.98"
                    TranslateY="10" />
            </Border.RenderTransform>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource CompactTextBrush}"
                        Text="{Binding MonthLabel}" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            Click="PreviousMonthButton_Click"
                            Style="{StaticResource CompactMonthNavButtonStyle}"
                            ToolTipService.ToolTip="Previous month">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            Click="NextMonthButton_Click"
                            Style="{StaticResource CompactMonthNavButtonStyle}"
                            ToolTipService.ToolTip="Next month">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE76C;" />
                        </Button>
                        <Button
                            Click="OpenMainAppButton_Click"
                            Style="{StaticResource CompactOpenMainAppButtonStyle}"
                            ToolTipService.ToolTip="Open app">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="5">
                                <Viewbox
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle
                                            Width="20"
                                            Height="16"
                                            Canvas.Left="2"
                                            Canvas.Top="4"
                                            RadiusX="2"
                                            RadiusY="2"
                                            Stroke="{StaticResource CompactTextBrush}"
                                            StrokeThickness="2" />
                                        <Ellipse
                                            Width="2"
                                            Height="2"
                                            Canvas.Left="5"
                                            Canvas.Top="7"
                                            Fill="{StaticResource CompactTextBrush}" />
                                        <Ellipse
                                            Width="2"
                                            Height="2"
                                            Canvas.Left="9"
                                            Canvas.Top="7"
                                            Fill="{StaticResource CompactTextBrush}" />
                                        <Ellipse
                                            Width="2"
                                            Height="2"
                                            Canvas.Left="13"
                                            Canvas.Top="7"
                                            Fill="{StaticResource CompactTextBrush}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="App" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl
                    Grid.Row="1"
                    Width="322"
                    HorizontalAlignment="Center"
                    ItemsSource="{Binding WeekdayLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Width="46"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource CompactMutedBrush}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl
                    Grid.Row="2"
                    Width="322"
                    HorizontalAlignment="Center"
                    IsTabStop="False"
                    ItemsSource="{Binding MonthDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="MonthDayButton_Click"
                                Style="{StaticResource CompactDayButtonStyle}">
                                <Grid Opacity="{Binding DayOpacity}">
                                    <Border
                                        Width="34"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AppAccentMutedBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding CompactSelectionVisibility}" />

                                    <Border
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AppAccentBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding TodayVisibility}" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding DayTextBrush}"
                                        Text="{Binding DayButtonText}" />

                                    <Border
                                        Width="12"
                                        Height="3"
                                        Margin="0,0,0,3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{Binding CompactIndicatorBrush}"
                                        CornerRadius="0"
                                        Visibility="{Binding TaskIndicatorVisibility}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Grid.Row="3"
                    Height="1"
                    Background="{StaticResource CompactDividerBrush}" />

                <Grid
                    Grid.Row="4"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Normal"
                        Foreground="{StaticResource CompactMutedBrush}"
                        Text="TODAY TASKS" />

                    <Button
                        Grid.Column="1"
                        Click="AddTaskButton_Click"
                        Content="+ NEW"
                        Style="{StaticResource CompactNewTaskButtonStyle}" />
                </Grid>

                <Grid
                    x:Name="TaskAreaHost"
                    Grid.Row="5"
                    Height="132">
                    <Grid Visibility="{Binding CompactSelectedDayContentVisibility}">
                        <ListView
                            Height="132"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource CompactTaskItemContainerStyle}"
                            ItemsSource="{Binding SelectedDayTasks}"
                            SelectionMode="None"
                            Visibility="{Binding SelectedDayTasksVisibility}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Height="58"
                                        Margin="0,0,0,8"
                                        Padding="10,7"
                                        Background="{StaticResource CompactTaskCardBrush}"
                                        BorderBrush="{Binding TaskAccentBrush}"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="6"
                                        Opacity="{Binding ContentOpacity}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid RowSpacing="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource CompactTextBrush}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="11"
                                                    Foreground="{StaticResource CompactMutedBrush}"
                                                    Text="{Binding CompactTimeText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <Button
                                                Grid.Column="1"
                                                Click="TaskCompletionButton_Click"
                                                Style="{StaticResource CompactTaskCompletionButtonStyle}"
                                                ToolTipService.ToolTip="Toggle done state">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="11"
                                                    Glyph="&#xE73E;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{Binding EmptySelectedDayTasksVisibility}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource CompactMutedBrush}"
                                Text="{Binding EmptySelectedDayTasksText}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border
                    x:Name="CompactEditorHost"
                    Grid.Row="2"
                    Grid.RowSpan="4"
                    Height="428"
                    VerticalAlignment="Bottom"
                        Padding="10"
                        Background="{StaticResource CompactComposerPanelBrush}"
                        BorderBrush="{StaticResource CompactDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding SelectedTaskVisibility}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CompactEditorHostTranslate" Y="12" />
                    </Border.RenderTransform>

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="1">
                                    <TextBlock
                                        FontFamily="Segoe UI Variable Display"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource CompactTextBrush}"
                                        Text="New task" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource CompactMutedBrush}"
                                        Text="{Binding EditorDateText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Click="CancelCompactEditorButton_Click"
                                    Style="{StaticResource CompactComposerSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Cancel">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="10"
                                        Glyph="&#xE711;" />
                                </Button>
                            </Grid>

                            <TextBox
                                x:Name="CompactEditorTitleTextBox"
                                Grid.Row="1"
                                MinHeight="32"
                                Padding="8,4"
                                PlaceholderText="Task title"
                                Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="CompactEditorTitleTextBox_KeyDown"
                                TextChanged="CompactEditorTitleTextBox_TextChanged" />

                            <Button
                                x:Name="CompactEditorDateButton"
                                Grid.Row="2"
                                Style="{StaticResource CompactComposerFieldButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="11"
                                        Foreground="{StaticResource CompactMutedBrush}"
                                        Glyph="&#xE787;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding EditorDateText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="9"
                                        Foreground="{StaticResource CompactMutedBrush}"
                                        Glyph="&#xE70D;" />
                                </Grid>

                                <Button.Flyout>
                                    <Flyout
                                        x:Name="CompactEditorDateFlyout"
                                        Opening="CompactEditorDateFlyout_Opening"
                                        Placement="BottomEdgeAlignedLeft">
                                        <Border
                                            Padding="8"
                                            Background="{ThemeResource AppShellBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <CalendarView
                                                x:Name="CompactEditorDateCalendarView"
                                                SelectedDatesChanged="CompactEditorDateCalendarView_SelectedDatesChanged"
                                                SelectionMode="Single" />
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Grid
                                Grid.Row="3"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch
                                    MinWidth="0"
                                    IsOn="{Binding EditorIsAllDay, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource CompactTextBrush}"
                                    Text="All Day" />
                            </Grid>

                            <ComboBox
                                x:Name="CompactEditorCategoryComboBox"
                                Grid.Row="4"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CompactEditorCategoryComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Work">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" Background="#267EE0" CornerRadius="4" />
                                        <TextBlock Text="Work" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Personal">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" Background="#7B61FF" CornerRadius="4" />
                                        <TextBlock Text="Personal" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Health">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" Background="#249D57" CornerRadius="4" />
                                        <TextBlock Text="Health" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Important">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" Background="#EE8423" CornerRadius="4" />
                                        <TextBlock Text="Important" />
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <ComboBox
                                x:Name="CompactEditorRecurrenceComboBox"
                                Grid.Row="5"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CompactEditorRecurrenceComboBox_SelectionChanged">
                                <ComboBoxItem Content="Does not repeat" Tag="None" />
                                <ComboBoxItem Content="Daily" Tag="Daily" />
                                <ComboBoxItem Content="Weekly" Tag="Weekly" />
                                <ComboBoxItem Content="Monthly" Tag="Monthly" />
                            </ComboBox>

                            <Grid
                                Grid.Row="6"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource CompactMutedBrush}"
                                        Text="Start" />
                                    <Button
                                        x:Name="CompactEditorTimeButton"
                                        IsEnabled="{Binding EditorTimeInputEnabled}"
                                        Style="{StaticResource CompactComposerFieldButtonStyle}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Foreground="{StaticResource CompactMutedBrush}"
                                                Glyph="&#xE823;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding EditorTimeText}" />
                                            <FontIcon
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="9"
                                                Foreground="{StaticResource CompactMutedBrush}"
                                                Glyph="&#xE70D;" />
                                        </Grid>

                                        <Button.Flyout>
                                            <Flyout
                                                x:Name="CompactEditorTimeFlyout"
                                                Opening="CompactEditorTimeFlyout_Opening"
                                                Placement="BottomEdgeAlignedLeft">
                                                <Border
                                                    Width="136"
                                                    Padding="4"
                                                    Background="{ThemeResource AppShellBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <ListView
                                                            x:Name="CompactEditorHourListView"
                                                            Height="128"
                                                            ItemsSource="{x:Bind CompactEditorHourOptions}"
                                                            SelectionChanged="CompactEditorTimeListView_SelectionChanged"
                                                            SelectionMode="Single" />
                                                        <Border
                                                            Grid.Column="1"
                                                            Margin="0,4"
                                                            Background="{StaticResource CompactDividerBrush}" />
                                                        <ListView
                                                            x:Name="CompactEditorMinuteListView"
                                                            Grid.Column="2"
                                                            Height="128"
                                                            ItemsSource="{x:Bind CompactEditorMinuteOptions}"
                                                            SelectionChanged="CompactEditorTimeListView_SelectionChanged"
                                                            SelectionMode="Single" />
                                                    </Grid>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource CompactMutedBrush}"
                                        Text="Duration" />
                                    <Button
                                        x:Name="CompactEditorDurationButton"
                                        IsEnabled="{Binding EditorDurationInputEnabled}"
                                        Style="{StaticResource CompactComposerFieldButtonStyle}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Foreground="{StaticResource CompactMutedBrush}"
                                                Glyph="&#xE916;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding EditorDurationText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <FontIcon
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="9"
                                                Foreground="{StaticResource CompactMutedBrush}"
                                                Glyph="&#xE70D;" />
                                        </Grid>

                                        <Button.Flyout>
                                            <Flyout
                                                x:Name="CompactEditorDurationFlyout"
                                                Opening="CompactEditorDurationFlyout_Opening"
                                                Placement="BottomEdgeAlignedLeft">
                                                <Border
                                                    Width="184"
                                                    Padding="4"
                                                    Background="{ThemeResource AppShellBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <ListView
                                                        x:Name="CompactEditorDurationListView"
                                                        Height="132"
                                                        IsItemClickEnabled="True"
                                                        ItemsSource="{Binding EditorDurationOptions}"
                                                        ItemClick="CompactEditorDurationListView_ItemClick"
                                                        SelectionMode="Single">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="54" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding EndTimeText}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        FontSize="12"
                                                                        Foreground="{StaticResource CompactMutedBrush}"
                                                                        Text="{Binding DescriptionText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel
                                Grid.Row="7"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    Click="CancelCompactEditorButton_Click"
                                    Content="Cancel"
                                    Style="{StaticResource CompactComposerSecondaryButtonStyle}" />
                                <Button
                                    x:Name="CompactEditorDoneButton"
                                    Click="DoneCompactEditorButton_Click"
                                    Content="Done"
                                    IsEnabled="False"
                                    Style="{StaticResource CompactComposerPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
