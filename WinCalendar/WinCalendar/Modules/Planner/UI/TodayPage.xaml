<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppPageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="HeaderToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="HeaderPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{ThemeResource AppAccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        </Style>

        <Style x:Key="EditorFieldBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="{ThemeResource AppShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="EditorTitleTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="EditorInlineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorInlineCalendarDatePickerStyle" TargetType="CalendarDatePicker">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="EditorDescriptionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="96" />
        </Style>

        <Style x:Key="EditorGhostIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Loaded="Root_Loaded"
        Padding="16">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="0,0,0,12"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="WEEK" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding MonthLabel}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2"
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding WeekLabel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="PreviousWeekButton_Click"
                            ToolTipService.ToolTip="Previous week">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76B;" />
                        </Button>

                        <Button
                            Style="{StaticResource HeaderToolbarButtonStyle}"
                            Click="CurrentWeekButton_Click"
                            Content="Today" />

                        <Button
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="NextWeekButton_Click"
                            ToolTipService.ToolTip="Next week">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76C;" />
                        </Button>

                        <Button
                            Style="{StaticResource HeaderPrimaryButtonStyle}"
                            Click="AddTaskButton_Click"
                            Content="New task" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="256" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="WEEK" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="{Binding WeekViewSummary}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="Click empty space to add a task" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource AppCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="12,10,8,10"
                                Background="{ThemeResource AppPageBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="0,0,1,1">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="TIME" />
                            </Border>

                            <ScrollViewer
                                x:Name="WeekTimelineHeaderScrollViewer"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                ViewChanged="WeekTimelineStickyScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{Binding WeekTimelineDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Style="{StaticResource FlatButtonStyle}"
                                                Click="WeekDayHeaderButton_Click"
                                                ToolTipService.ToolTip="{Binding FullDateText}">
                                                <Grid
                                                    Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                                    Height="60"
                                                    Background="{ThemeResource AppPageBackgroundBrush}">
                                                    <Border
                                                        Visibility="{Binding SelectionVisibility}"
                                                        Background="{ThemeResource AppAccentMutedBrush}"
                                                        Opacity="0.5" />
                                                    <Border
                                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                                        BorderThickness="0,0,1,1" />
                                                    <Border
                                                        Width="3"
                                                        HorizontalAlignment="Left"
                                                        Background="{ThemeResource AppAccentBrush}"
                                                        Visibility="{Binding SelectionVisibility}" />

                                                    <Grid
                                                        Padding="12,10"
                                                        ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                                Text="{Binding DayNameText}" />
                                                            <TextBlock
                                                                FontFamily="Segoe UI Variable Display"
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DayNumberText}" />
                                                        </StackPanel>

                                                        <Border
                                                            Grid.Column="1"
                                                            Width="8"
                                                            Height="8"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource AppAccentBrush}"
                                                            CornerRadius="999"
                                                            Visibility="{Binding TodayVisibility}" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Height="{Binding WeekTimelineAnyTimeLaneHeight}"
                                Padding="12,10,8,8"
                                Background="{ThemeResource AppPageBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="0,0,1,1">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="ALL DAY" />
                            </Border>

                            <ScrollViewer
                                x:Name="WeekTimelineAllDayScrollViewer"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                ViewChanged="WeekTimelineStickyScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{Binding WeekTimelineDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                                Height="{Binding DataContext.WeekTimelineAnyTimeLaneHeight, ElementName=LayoutRoot}"
                                                Background="{ThemeResource AppCardBackgroundBrush}">
                                                <Border
                                                    Visibility="{Binding SelectionVisibility}"
                                                    Background="{ThemeResource AppAccentMutedBrush}"
                                                    Opacity="0.16" />
                                                <Border
                                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                                    BorderThickness="0,0,1,1" />

                                                <Grid
                                                    Background="Transparent"
                                                    Tapped="WeekAllDayLane_Tapped">
                                                    <Grid Padding="6,6,4,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock
                                                            Visibility="{Binding EmptyAllDayVisibility}"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Text="Add task" />

                                                        <ScrollViewer
                                                            Grid.Row="1"
                                                            Margin="0,4,0,0"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            VerticalScrollBarVisibility="Auto"
                                                            VerticalScrollMode="Enabled"
                                                            ZoomMode="Disabled">
                                                            <ItemsControl ItemsSource="{Binding VisibleAllDayTasks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button
                                                                            Margin="0,0,0,2"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Style="{StaticResource FlatButtonStyle}"
                                                                            Click="WeekAllDayTaskButton_Click">
                                                                            <Border
                                                                                Padding="5,2"
                                                                                Background="{Binding TaskBackgroundBrush}"
                                                                                BorderBrush="{Binding TaskBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="5"
                                                                                Opacity="{Binding ContentOpacity}">
                                                                                <TextBlock
                                                                                    FontSize="10"
                                                                                    FontWeight="SemiBold"
                                                                                    Text="{Binding Title}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </Border>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer
                                x:Name="WeekTimelineHoursScrollViewer"
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                ViewChanged="WeekTimelineHoursScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{Binding WeekTimelineHours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}"
                                                Padding="12,6,8,0"
                                                Background="{ThemeResource AppPageBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="0,0,1,1">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="{Binding LabelText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer
                                x:Name="WeekTimelineScrollViewer"
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                ViewChanged="WeekTimelineScrollViewer_ViewChanged">
                                <Grid x:Name="WeekTimelineContentGrid">
                                    <ItemsControl ItemsSource="{Binding WeekTimelineDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                                    Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}"
                                                    Background="{ThemeResource AppCardBackgroundBrush}">
                                                    <Border
                                                        Visibility="{Binding SelectionVisibility}"
                                                        Background="{ThemeResource AppAccentMutedBrush}"
                                                        Opacity="0.16" />
                                                    <Border
                                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                                        BorderThickness="0,0,1,0" />

                                                    <Grid>
                                                        <Border
                                                            Background="Transparent"
                                                            Tapped="WeekTimedGrid_Tapped" />

                                                        <ItemsControl
                                                            IsHitTestVisible="False"
                                                            ItemsSource="{Binding DataContext.WeekTimelineHours, ElementName=LayoutRoot}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}"
                                                                        BorderBrush="{ThemeResource AppLineBrush}"
                                                                        BorderThickness="0,0,0,1" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ItemsControl
                                                            Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}"
                                                            ItemsSource="{Binding TimedTaskBlocks}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        Width="{Binding Width}"
                                                                        Height="{Binding Height}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Style="{StaticResource FlatButtonStyle}"
                                                                        VerticalContentAlignment="Stretch"
                                                                        Click="WeekTimedTaskButton_Click">
                                                                        <Button.RenderTransform>
                                                                            <TranslateTransform
                                                                                X="{Binding Left}"
                                                                                Y="{Binding Top}" />
                                                                        </Button.RenderTransform>
                                                                        <Border
                                                                            Padding="{Binding ContentPadding}"
                                                                            Background="{Binding BackgroundBrush}"
                                                                            BorderBrush="{Binding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Opacity="{Binding ContentOpacity}">
                                                                            <Grid ColumnSpacing="5">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <Border
                                                                                    Margin="0,1,0,1"
                                                                                    Background="{Binding AccentBrush}"
                                                                                    CornerRadius="2" />

                                                                                <Grid
                                                                                    Grid.Column="1"
                                                                                    RowSpacing="0">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="*" />
                                                                                    </Grid.RowDefinitions>

                                                                                    <TextBlock
                                                                                        FontSize="{Binding TitleFontSize}"
                                                                                        FontWeight="SemiBold"
                                                                                        MaxLines="{Binding TitleMaxLines}"
                                                                                        Text="{Binding Title}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        TextWrapping="{Binding TitleWrapping}" />

                                                                                    <TextBlock
                                                                                        Grid.Row="1"
                                                                                        FontSize="{Binding TimeFontSize}"
                                                                                        Foreground="{Binding AccentBrush}"
                                                                                        Text="{Binding BottomTimeText}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border
                                        IsHitTestVisible="False"
                                        Height="2"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AppAccentBrush}"
                                        Opacity="1"
                                        Visibility="{Binding CurrentWeekTimeIndicatorVisibility}">
                                        <Border.RenderTransform>
                                            <TranslateTransform
                                                Y="{Binding CurrentTimeIndicatorTop}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Margin="0,2,0,2"
                        Background="{ThemeResource AppBorderBrush}" />

                    <Grid
                        Grid.Column="1"
                        Padding="18,0,0,0">
                        <Grid>
                            <StackPanel
                                Spacing="10"
                                Visibility="{Binding EmptySelectedTaskVisibility}">
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="No task selected" />
                                <TextBlock
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="Select a task in the week grid or click an empty slot to create a new one."
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource HeaderPrimaryButtonStyle}"
                                    Click="AddTaskButton_Click"
                                    Content="New task" />
                            </StackPanel>

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding SelectedTaskVisibility}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="EditorTitleTextBox"
                                            Style="{StaticResource EditorTitleTextBoxStyle}"
                                            PlaceholderText="Untitled"
                                            Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="EditorTitleTextBox_TextChanged"
                                            LostFocus="EditorTitleTextBox_LostFocus" />

                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource EditorGhostIconButtonStyle}"
                                            Click="CloseEditorButton_Click"
                                            ToolTipService.ToolTip="Close editor">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource EditorFieldBorderStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="Date" />

                                                <CalendarDatePicker
                                                    x:Name="EditorDatePicker"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    Date="{Binding EditorDate, Mode=TwoWay}"
                                                    DateChanged="EditorDatePicker_DateChanged"
                                                    Style="{StaticResource EditorInlineCalendarDatePickerStyle}" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EditorFieldBorderStyle}">
                                            <Grid
                                                ColumnSpacing="12"
                                                RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="Time" />

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding EditorTimeVisibility}">
                                                    <ComboBox
                                                        x:Name="EditorHourComboBox"
                                                        Width="64"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding EditorHourOptions}"
                                                        SelectedValue="{Binding EditorHourValue, Mode=TwoWay}"
                                                        SelectedValuePath="Value"
                                                        SelectionChanged="EditorHourComboBox_SelectionChanged"
                                                        Style="{StaticResource EditorInlineComboBoxStyle}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource AppTextMutedBrush}"
                                                        Text=":" />
                                                    <ComboBox
                                                        x:Name="EditorMinuteComboBox"
                                                        Width="64"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding EditorMinuteOptions}"
                                                        SelectedValue="{Binding EditorMinuteValue, Mode=TwoWay}"
                                                        SelectedValuePath="Value"
                                                        SelectionChanged="EditorMinuteComboBox_SelectionChanged"
                                                        Style="{StaticResource EditorInlineComboBoxStyle}" />
                                                </StackPanel>

                                                <ToggleSwitch
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    IsOn="{Binding EditorHasTime, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="EditorTimeToggle_Toggled" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            Style="{StaticResource EditorFieldBorderStyle}"
                                            Visibility="{Binding EditorTimeVisibility}">
                                            <Grid
                                                ColumnSpacing="12"
                                                RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                                    Text="Length" />

                                                <ComboBox
                                                    x:Name="EditorDurationComboBox"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    DisplayMemberPath="Label"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{Binding EditorDurationInputEnabled}"
                                                    ItemsSource="{Binding EditorDurationOptions}"
                                                    SelectedValue="{Binding EditorDurationSelectedValue, Mode=TwoWay}"
                                                    SelectedValuePath="Value"
                                                    SelectionChanged="EditorDurationComboBox_SelectionChanged"
                                                    Style="{StaticResource EditorInlineComboBoxStyle}"
                                                    Visibility="{Binding EditorDurationVisibility}" />

                                                <ToggleSwitch
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding EditorDurationToggleEnabled}"
                                                    IsOn="{Binding EditorHasDuration, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="EditorDurationToggle_Toggled" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Border Style="{StaticResource EditorFieldBorderStyle}">
                                        <TextBox
                                            x:Name="EditorDescriptionTextBox"
                                            Style="{StaticResource EditorDescriptionTextBoxStyle}"
                                            PlaceholderText="Add description..."
                                            Text="{Binding EditorDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="EditorDescriptionTextBox_TextChanged"
                                            LostFocus="EditorDescriptionTextBox_LostFocus" />
                                    </Border>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Style="{StaticResource HeaderToolbarButtonStyle}"
                                            Click="CompleteTaskButton_Click"
                                            Visibility="{Binding EditorCompleteVisibility}">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" />
                                                <TextBlock Text="{Binding EditorCompletionButtonText}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource EditorGhostIconButtonStyle}"
                                            Click="DeleteSelectedTaskButton_Click"
                                            ToolTipService.ToolTip="Delete task"
                                            Visibility="{Binding EditorDeleteVisibility}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
