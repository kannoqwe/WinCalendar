<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.CompactPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Loaded="Root_Loaded" Padding="{Binding CompactPanelRootPadding}">
        <Border
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding CompactPanelCornerRadius}"
            Padding="12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button MinWidth="34" Click="ToggleSidebarButton_Click" Content="{Binding CompactSidebarToggleText}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding MonthLabel}" />
                    <Button Grid.Column="2" MinWidth="58" Click="OpenMediumButton_Click" Content="Day" />
                    <Button Grid.Column="3" MinWidth="54" Click="OpenFullButton_Click" Content="App" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Click="PreviousMonthButton_Click" Content="&#xE100;" FontFamily="Segoe Fluent Icons" />
                    <Button Grid.Column="1" Click="NextMonthButton_Click" Content="&#xE101;" FontFamily="Segoe Fluent Icons" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="{Binding SelectedDateText}" />
                    <Button Grid.Column="3" Click="TodayButton_Click" Content="Today" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Center" Text="Mo" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="Tu" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="We" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="Th" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="Fr" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Center" Text="Sa" />
                    <TextBlock Grid.Column="6" HorizontalAlignment="Center" Text="Su" />
                </Grid>

                <GridView
                    Grid.Row="3"
                    ItemsSource="{Binding MonthDays}"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Width" Value="48" />
                            <Setter Property="Height" Value="42" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource FlatButtonStyle}"
                                Click="MonthDayButton_Click"
                                DoubleTapped="MonthDayButton_DoubleTapped">
                                <Grid Opacity="{Binding DayOpacity}">
                                    <Border
                                        Visibility="{Binding CompactSelectionVisibility}"
                                        Background="{ThemeResource AppAccentMutedBrush}"
                                        CornerRadius="12" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                        <Grid>
                                            <TextBlock
                                                Visibility="{Binding CompactNormalNumberVisibility}"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding DayButtonText}" />
                                            <TextBlock
                                                Visibility="{Binding CompactTodayNumberVisibility}"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppAccentBrush}"
                                                Text="{Binding DayButtonText}" />
                                        </Grid>
                                        <Border
                                            Visibility="{Binding TaskIndicatorVisibility}"
                                            Width="6"
                                            Height="6"
                                            Background="{Binding IndicatorBrush}"
                                            CornerRadius="999" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Border>
    </Grid>
</Page>
