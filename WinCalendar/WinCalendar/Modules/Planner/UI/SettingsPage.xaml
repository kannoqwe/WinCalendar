<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Border
            Margin="24"
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
            <StackPanel Spacing="18">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="APPEARANCE" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Theme" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Choose how the main app follows Windows." />
                        </StackPanel>

                        <ComboBox
                            x:Name="ThemeComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="System" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <Border
                    Height="1"
                    Background="{ThemeResource AppBorderBrush}" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="CURRENT DEFAULTS" />
                    <TextBlock Text="Date format: DD.MM.YYYY" />
                    <TextBlock Text="Time format: 24h" />
                    <TextBlock Text="Compact panel stays connected to the full app through shared state." />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
