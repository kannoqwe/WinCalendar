<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Border
            Margin="24"
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
            <StackPanel Spacing="18">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="APPEARANCE" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Theme" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Choose how the main app follows Windows." />
                        </StackPanel>

                        <ComboBox
                            x:Name="ThemeComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="System" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <Border
                    Height="1"
                    Background="{ThemeResource AppBorderBrush}" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="CALENDAR" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Time format" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Choose how task times should be displayed." />
                        </StackPanel>

                        <ComboBox
                            x:Name="TimeFormatComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="TimeFormatComboBox_SelectionChanged">
                            <ComboBoxItem Content="24-hour" Tag="TwentyFourHour" />
                            <ComboBoxItem Content="12-hour" Tag="TwelveHour" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="First day of week" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Set the calendar grid preference." />
                        </StackPanel>

                        <ComboBox
                            x:Name="WeekStartComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="WeekStartComboBox_SelectionChanged">
                            <ComboBoxItem Content="Monday" Tag="Monday" />
                            <ComboBoxItem Content="Sunday" Tag="Sunday" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <Border
                    Height="1"
                    Background="{ThemeResource AppBorderBrush}" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        Text="OVERLAY" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Taskbar overlay" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}"
                                Text="Show the click target near the Windows clock." />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="OverlayEnabledToggleSwitch"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsOn="True"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="OverlayEnabledToggleSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Overlay size" />
                            <TextBlock
                                x:Name="OverlaySizeTextBlock"
                                FontSize="13"
                                Foreground="{ThemeResource AppTextMutedBrush}" />
                        </StackPanel>

                        <Button
                            x:Name="ResizeOverlayButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="ResizeOverlayButton_Click"
                            Content="Change size" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
