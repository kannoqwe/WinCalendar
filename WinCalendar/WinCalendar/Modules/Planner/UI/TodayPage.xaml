<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCalendar.Modules.Planner.UI.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppCardAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{ThemeResource AppCardAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Loaded="Root_Loaded"
        Padding="12">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource IconButtonStyle}"
                            Click="PreviousWeekButton_Click"
                            ToolTipService.ToolTip="Previous week">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76B;" />
                        </Button>

                        <Button
                            Style="{StaticResource IconButtonStyle}"
                            Click="NextWeekButton_Click"
                            ToolTipService.ToolTip="Next week">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="1"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding WeekLabel}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="{Binding QuickAddTargetText}" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="CurrentWeekButton_Click"
                        Content="This week" />

                    <Button
                        Grid.Column="3"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="{ThemeResource AppAccentBrush}"
                        BorderBrush="{ThemeResource AppAccentBrush}"
                        BorderThickness="0"
                        Click="AddTaskButton_Click"
                        CornerRadius="12"
                        ToolTipService.ToolTip="Add task">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Foreground="White"
                            Glyph="&#xE710;" />
                    </Button>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="10">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding WeekTimelineDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,8,0"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Click="WeekDayHeaderButton_Click">
                                        <Border
                                            Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                            Padding="10,8"
                                            Background="{ThemeResource AppShellBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <Grid>
                                                <Border
                                                    Visibility="{Binding SelectionVisibility}"
                                                    Background="{ThemeResource AppAccentMutedBrush}"
                                                    CornerRadius="12" />

                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="1">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Text="{Binding DayNameText}" />
                                                        <TextBlock
                                                            FontFamily="Segoe UI Variable Display"
                                                            FontSize="20"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding DayNumberText}" />
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="1"
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource AppAccentBrush}"
                                                        CornerRadius="999"
                                                        Visibility="{Binding TodayVisibility}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,8,0"
                            Spacing="0">
                            <Border
                                Height="{Binding WeekTimelineAnyTimeLaneHeight}"
                                Padding="0,8,0,0">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource AppTextMutedBrush}"
                                    Text="Any" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding WeekTimelineHours}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}">
                                            <TextBlock
                                                VerticalAlignment="Top"
                                                FontSize="11"
                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                Text="{Binding LabelText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl
                            Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding WeekTimelineDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="{Binding DataContext.WeekTimelineDayWidth, ElementName=LayoutRoot}"
                                        Margin="0,0,8,0"
                                        Background="{ThemeResource AppShellBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <Grid>
                                            <Border
                                                Visibility="{Binding SelectionVisibility}"
                                                Background="{ThemeResource AppAccentMutedBrush}"
                                                Opacity="0.28"
                                                CornerRadius="14" />

                                            <StackPanel Spacing="0">
                                                <Border
                                                    Height="{Binding DataContext.WeekTimelineAnyTimeLaneHeight, ElementName=LayoutRoot}"
                                                    Padding="8,6"
                                                    Background="{ThemeResource AppCardAltBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AppLineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            Visibility="{Binding EmptyAllDayVisibility}"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                                            Text="Free" />

                                                        <ItemsControl ItemsSource="{Binding VisibleAllDayTasks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        Style="{StaticResource FlatButtonStyle}"
                                                                        Click="WeekAllDayTaskButton_Click">
                                                                        <Border
                                                                            Padding="6,4"
                                                                            Background="{Binding TaskBackgroundBrush}"
                                                                            BorderBrush="{Binding TaskBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Opacity="{Binding ContentOpacity}">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                FontWeight="SemiBold"
                                                                                Text="{Binding Title}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Border
                                                            Visibility="{Binding HiddenAllDayTaskCountVisibility}"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Left"
                                                            Background="{ThemeResource AppCardBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{ThemeResource AppTextMutedBrush}"
                                                                Text="{Binding HiddenAllDayTaskCountText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <Grid Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}">
                                                    <ItemsControl
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding DataContext.WeekTimelineHours, ElementName=LayoutRoot}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Height="{Binding DataContext.WeekTimelineHourHeight, ElementName=LayoutRoot}"
                                                                    BorderBrush="{ThemeResource AppLineBrush}"
                                                                    BorderThickness="0,0,0,1" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <ItemsControl
                                                        Height="{Binding DataContext.WeekTimelineTimedHeight, ElementName=LayoutRoot}"
                                                        ItemsSource="{Binding TimedTaskBlocks}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button
                                                                    Width="{Binding Width}"
                                                                    Height="{Binding Height}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Style="{StaticResource FlatButtonStyle}"
                                                                    VerticalContentAlignment="Stretch"
                                                                    Click="WeekTimedTaskButton_Click">
                                                                    <Button.RenderTransform>
                                                                        <TranslateTransform
                                                                            X="{Binding Left}"
                                                                            Y="{Binding Top}" />
                                                                    </Button.RenderTransform>
                                                                        <Border
                                                                            Padding="4,2"
                                                                            Background="{Binding BackgroundBrush}"
                                                                            BorderBrush="{Binding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Opacity="{Binding ContentOpacity}">
                                                                            <StackPanel Spacing="0">
                                                                                <TextBlock
                                                                                    FontSize="10"
                                                                                    FontWeight="SemiBold"
                                                                                    MaxLines="1"
                                                                                    Text="{Binding Title}"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    TextWrapping="NoWrap" />
                                                                                <TextBlock
                                                                                    FontSize="9"
                                                                                    Foreground="{Binding AccentBrush}"
                                                                                    Text="{Binding TimeText}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
